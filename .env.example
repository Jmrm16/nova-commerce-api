# Application
PROJECT_NAME="Nova Commerce API"
API_V1_STR="/api/v1"
DEBUG=True

# Database (defaults to SQLite for local dev; swap with postgresql in production)
DATABASE_URL="sqlite:///./nova_commerce.db"
# DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/nova_commerce"

# Security
SECRET_KEY="change-this-in-production-use-openssl-rand-hex-32"
ACCESS_TOKEN_EXPIRE_MINUTES=120
ALGORITHM="HS256"

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]
